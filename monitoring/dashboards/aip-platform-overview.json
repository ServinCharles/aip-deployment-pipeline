        "h": 6,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "type": "row",
      "title": "Services (Beyla automatic instrumentation)",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "HTTP requests handled by each service.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$env-(dip|api)\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 14,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx)",
      "description": "Share of requests that failed with a 5xx status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$env-(dip|api)\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum by (service_name) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$env-(dip|api)\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 15,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 21
      }
    },
    {
      "type": "timeseries",
      "title": "Response time p95",
      "description": "95% of requests finish within this time.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=~\"$env-(dip|api)\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 16,
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 21
      }
    },
    {
      "type": "row",
      "title": "Kubernetes",
      "collapsed": false,
      "panels": [],
      "id": 17,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "bargauge",
      "title": "Restarts",
      "description": "Container restarts in the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=~\"$env-.*\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{container}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
