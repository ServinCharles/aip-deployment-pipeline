{
  "uid": "aip-platform-overview",
  "title": "AIP Platform Overview",
  "description": "Mortgage decisions, chatbot, service health (Beyla) and Kubernetes for the AIP platform.",
  "tags": [
    "aip",
    "kubernetes",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "sit-01,sit-02",
        "current": {
          "text": "sit-01",
          "value": "sit-01"
        },
        "options": [
          {
            "text": "sit-01",
            "value": "sit-01",
            "selected": true
          },
          {
            "text": "sit-02",
            "value": "sit-02",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "applicationId",
        "label": "Application ID",
        "type": "textbox",
        "query": "AIP-",
        "current": {
          "text": "AIP-",
          "value": "AIP-"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Mortgage decisions (audit service logs)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Decisions audited",
      "description": "AipDecisionMade events stored in the audit trail in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-audit-service\"} |= \"Audited\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Duplicates ignored",
      "description": "Events Kafka delivered again and the audit service stored only once (at-least-once delivery working).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-audit-service\"} |= \"Duplicate event\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Dead-lettered",
      "description": "Events that broke the contract and went to aip.decisions.dlq. Should be 0.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-audit-service\"} |= \"dead-letter topic\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Not saved or published",
      "description": "Decisions aip-api could not save to MongoDB or publish to Kafka. Should be 0.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-api\"} |~ \"was not (saved|published)\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Decisions by outcome",
      "description": "Accepted, Referred and Declined, from the Decision field of the audit log.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (decision) (count_over_time({namespace=\"$env-api\", container=\"aip-audit-service\"} |= \"Audited\" | json decision=\"State.Decision\" [$__range]))",
          "refId": "A",
          "legendFormat": "{{decision}}",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 6,
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Decisions over time",
      "description": "Audited decisions per interval, by outcome.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (decision) (count_over_time({namespace=\"$env-api\", container=\"aip-audit-service\"} |= \"Audited\" | json decision=\"State.Decision\" [$__auto]))",
          "refId": "A",
          "legendFormat": "{{decision}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Chatbot (aip-chat-api logs)",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "stat",
      "title": "Questions",
      "description": "Chat messages answered in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-chat-api\"} |= \"Chat intent\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 9,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "stat",
      "title": "Fallback rate",
      "description": "Share of questions the bot could not match to an intent. A rising rate means new training data is needed.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-chat-api\"} |= \"Chat intent\" | json intent=\"State.Intent\" | intent=\"fallback\" [$__range])) / sum(count_over_time({namespace=\"$env-api\", container=\"aip-chat-api\"} |= \"Chat intent\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 10,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 14
      }
    },
    {
      "type": "stat",
      "title": "Personal data blocked",
      "description": "Messages with card, account, sort code or National Insurance numbers, blocked by the guardrail.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({namespace=\"$env-api\", container=\"aip-chat-api\"} |= \"Chat intent\" | json intent=\"State.Intent\" | intent=\"personal_data_blocked\" [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
