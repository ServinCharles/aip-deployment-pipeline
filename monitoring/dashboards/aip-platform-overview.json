        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 14
      }
    },
    {
      "type": "bargauge",
      "title": "Questions by intent",
      "description": "What customers ask about, including handovers (speak_to_advisor, complaint).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (intent) (count_over_time({namespace=\"$env-api\", container=\"aip-chat-api\"} |= \"Chat intent\" | json intent=\"State.Intent\" [$__range]))",
          "refId": "A",
          "legendFormat": "{{intent}}",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
