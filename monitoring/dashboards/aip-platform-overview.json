        "h": 7,
        "w": 8,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "stat",
      "title": "OOMKilled containers",
      "description": "Containers whose last restart was caused by running out of memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=~\"$env-.*\", reason=\"OOMKilled\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
